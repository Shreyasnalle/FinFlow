# Copy to .env and fill in. .env is git-ignored; never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
CLASSIFIER_MODEL=openai/gpt-oss-20b

# Web search (Firecrawl). Use the cloud key, or point FIRECRAWL_API_URL at a self-hosted instance.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=

# Rate limiting for /chat and /chat/stream (all optional; defaults shown). /health is never limited.
# Counters live in memory, so run a single worker.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=12            # per client IP
# RATE_LIMIT_PER_DAY=200              # per client IP
# RATE_LIMIT_GLOBAL_PER_MINUTE=60     # all clients together (protects your model quota)
# RATE_LIMIT_GLOBAL_PER_DAY=2000
# Behind a reverse proxy (e.g. Render) tell the limiter where the client IP is. Entries are read
# from the right because clients can add their own to the left. Verify the hop count after deploying.
# RATE_LIMIT_CLIENT_IP_HEADER=X-Forwarded-For
# RATE_LIMIT_FORWARDED_HOPS=1
# RATE_LIMIT_DEBUG_LOG_CLIENTS=false  # temporarily true to see how the client IP is resolved
# The /users endpoints have their own budgets:
# RATE_LIMIT_USERS_PER_MINUTE=30
# RATE_LIMIT_USERS_PER_DAY=1000
# RATE_LIMIT_USERS_GLOBAL_PER_MINUTE=120
# RATE_LIMIT_USERS_GLOBAL_PER_DAY=5000

# Requests bigger than this are refused with HTTP 413 before being read into memory (bytes).
# MAX_REQUEST_BYTES=2000000

# The /users endpoints (data sync, memory) have no authentication yet. Set false on any public deployment.
# USERS_API_ENABLED=true
# Where the SQLite file for synced data and memory lives (default agent/data/finflow_agent.db).
# On hosts without persistent disk (e.g. Render's free plan) it is wiped on restart.
# FINFLOW_AGENT_DB=
