# Copy to .env and fill in. .env is git-ignored; never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
CLASSIFIER_MODEL=openai/gpt-oss-20b

# Web search (Firecrawl). Use the cloud key, or point FIRECRAWL_API_URL at a self-hosted instance.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
